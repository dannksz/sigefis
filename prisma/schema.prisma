datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client-js"
}

model estado {
  id      Int      @id @default(autoincrement())
  nome    String   @db.VarChar(45)
  sigla   String   @db.VarChar(45)
  regiao  String   @db.VarChar(45)
  cidades cidade[]
}

model cidade {
  id        Int        @id @default(autoincrement())
  nome      String     @db.VarChar(100)
  estadoId  Int
  estado    estado     @relation(fields: [estadoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  enderecos endereco[]

  @@index([estadoId], map: "cidade_estadoId_fkey")
}

model endereco {
  id           Int            @id @default(autoincrement())
  logradouro   String         @db.VarChar(191)
  numero       String         @db.VarChar(10)
  complemento  String?        @db.VarChar(45)
  bairro       String         @db.VarChar(45)
  cep          String         @db.VarChar(8)
  cidadeId     Int
  cidade       cidade         @relation(fields: [cidadeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  empresas     empresa[]
  orgaos       orgao_publico[]
  projetos     projeto_obra[]
  usuarios     usuario[]

  @@index([cidadeId], map: "endereco_cidadeId_fkey")
}

model usuario {
  id                  Int                     @id @default(autoincrement())
  nome                String                  @db.VarChar(191)
  email               String                  @unique @db.VarChar(191)
  senha               String                  @db.VarChar(191)
  cpf                 String                  @db.VarChar(11)
  cnpj                String?                 @db.VarChar(14)
  dataNascimento      DateTime?               @db.DateTime(0)
  role                String                  @db.VarChar(45)
  criadoEm            DateTime                @default(now()) @db.DateTime(3)
  atualizadoEm        DateTime                @updatedAt @db.DateTime(3)
  enderecoId          Int?
  endereco            endereco?               @relation(fields: [enderecoId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  tokenVerificacao    String?                 @db.VarChar(191)
  fiscalizacoes       fiscalizacao[]
  logs                log_auditoria[]
  obrasFiscais        obra_fiscal[]
  processosReg        processo_regularizacao[]

  @@index([enderecoId], map: "usuario_enderecoId_fkey")
}

model orgao_publico {
  id            Int             @id @default(autoincrement())
  nome          String          @db.VarChar(45)
  sigla         String          @db.VarChar(45)
  enderecoId    Int?
  endereco      endereco?       @relation(fields: [enderecoId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  contas        conta_bancaria[]
  verbas        verba_publica[]

  @@index([enderecoId], map: "orgao_publico_enderecoId_fkey")
}

model verba_publica {
  id               Int                @id @default(autoincrement())
  valor            Decimal            @db.Decimal(12, 2)
  origem           String             @db.VarChar(45)
  finalidade       String             @db.VarChar(65)
  orgaoId          Int
  orgaoPublico     orgao_publico      @relation(fields: [orgaoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  contratos        contrato[]
  emendas          emenda_parlamentar[]
  liberacoes       liberacao_recurso[]
  projetosVerba    projeto_verba[]

  @@index([orgaoId], map: "verba_publica_orgaoId_fkey")
}

model emenda_parlamentar {
  id           Int           @id @default(autoincrement())
  numero       String        @db.VarChar(45)
  autor        String        @db.VarChar(45)
  valor        Decimal       @db.Decimal(12, 2)
  verbaId      Int
  verbaPublica verba_publica @relation(fields: [verbaId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([verbaId], map: "emenda_parlamentar_verbaId_fkey")
}

model projeto_obra {
  id                 Int                  @id @default(autoincrement())
  nome               String               @db.VarChar(45)
  descricao          String               @db.VarChar(250)
  finalidade         String               @db.VarChar(45)
  enderecoId         Int
  endereco           endereco             @relation(fields: [enderecoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  alertas            alerta_fiscalizacao[]
  bloqueios          bloqueio_repasse[]
  contas             conta_bancaria[]
  contratos          contrato[]
  etapas             etapa_cronograma[]
  fiscalizacoes      fiscalizacao[]
  obrasFiscais       obra_fiscal[]
  projetosVerba      projeto_verba[]

  @@index([enderecoId], map: "projeto_obra_enderecoId_fkey")
}

model projeto_verba {
  id              Int           @id @default(autoincrement())
  projetoObraId   Int
  verbaPublicaId  Int
  valorAlocado    Decimal       @db.Decimal(12, 2)
  dataVinculacao  DateTime      @default(now()) @db.DateTime(0)
  projetoObra     projeto_obra  @relation(fields: [projetoObraId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  verbaPublica    verba_publica @relation(fields: [verbaPublicaId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([projetoObraId], map: "projeto_verba_projetoObraId_fkey")
  @@index([verbaPublicaId], map: "projeto_verba_verbaPublicaId_fkey")
}

model etapa_cronograma {
  id                  Int                 @id @default(autoincrement())
  projetoObraId       Int
  nomeEtapa           String              @db.VarChar(45)
  ordemEtapa          Int
  percentualPrevisto  Decimal             @db.Decimal(5, 2)
  percentualExecutado Decimal             @db.Decimal(5, 2)
  dataInicioPrevista  DateTime            @db.Date
  dataFimPrevista     DateTime            @db.Date
  dataInicioReal      DateTime?           @db.Date
  dataFimReal         DateTime?           @db.Date
  status              String              @db.VarChar(45)
  projetoObra         projeto_obra        @relation(fields: [projetoObraId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  fiscalizacoes       fiscalizacao[]
  liberacoes          liberacao_recurso[]
  pagamentos          pagamento[]

  @@index([projetoObraId], map: "etapa_cronograma_projetoObraId_fkey")
}

model liberacao_recurso {
  id               Int              @id @default(autoincrement())
  valorLiberacao   Decimal          @db.Decimal(12, 2)
  dataLiberacao    DateTime         @db.Date
  verbaPublicaId   Int
  etapaCronogramaId Int
  etapaCronograma  etapa_cronograma @relation(fields: [etapaCronogramaId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  verbaPublica     verba_publica    @relation(fields: [verbaPublicaId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([etapaCronogramaId], map: "liberacao_recurso_etapaCronogramaId_fkey")
  @@index([verbaPublicaId], map: "liberacao_recurso_verbaPublicaId_fkey")
}

model empresa {
  id                 Int        @id @default(autoincrement())
  nome               String     @db.VarChar(191)
  cnpj               String     @unique @db.VarChar(18)
  representanteLegal String     @db.VarChar(191)
  telefone           String     @db.VarChar(20)
  email              String     @db.VarChar(191)
  enderecoId         Int
  endereco           endereco   @relation(fields: [enderecoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  contratos          contrato[]

  @@index([enderecoId], map: "empresa_enderecoId_fkey")
}

model contrato {
  id              Int           @id @default(autoincrement())
  numeroContrato  String        @db.VarChar(45)
  valorContrato   Decimal       @db.Decimal(12, 2)
  dataAssinatura  DateTime      @db.Date
  dataInicio      DateTime      @db.Date
  dataFim         DateTime      @db.Date
  projetoObraId   Int
  empresaId       Int
  verbaPublicaId  Int
  empresa         empresa       @relation(fields: [empresaId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  projetoObra     projeto_obra  @relation(fields: [projetoObraId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  verbaPublica    verba_publica @relation(fields: [verbaPublicaId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  pagamentos      pagamento[]

  @@index([empresaId], map: "contrato_empresaId_fkey")
  @@index([projetoObraId], map: "contrato_projetoObraId_fkey")
  @@index([verbaPublicaId], map: "contrato_verbaPublicaId_fkey")
}

model pagamento {
  id                Int              @id @default(autoincrement())
  valorPagamento    Decimal          @db.Decimal(12, 2)
  dataPagamento     DateTime         @db.Date
  numeroNotaFiscal  String           @db.VarChar(45)
  contratoId        Int
  etapaCronogramaId Int
  contrato          contrato         @relation(fields: [contratoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  etapaCronograma   etapa_cronograma @relation(fields: [etapaCronogramaId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([contratoId], map: "pagamento_contratoId_fkey")
  @@index([etapaCronogramaId], map: "pagamento_etapaCronogramaId_fkey")
}

model obra_fiscal {
  id             Int          @id @default(autoincrement())
  dataDesignacao DateTime     @db.Date
  usuarioId      Int
  projetoObraId  Int
  projetoObra    projeto_obra @relation(fields: [projetoObraId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  usuario        usuario      @relation(fields: [usuarioId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([projetoObraId], map: "obra_fiscal_projetoObraId_fkey")
  @@index([usuarioId], map: "obra_fiscal_usuarioId_fkey")
}

model fiscalizacao {
  id                  Int                     @id @default(autoincrement())
  dataVistoria        DateTime                @db.Date
  percentualExecutado Decimal                 @db.Decimal(5, 2)
  parecerTecnico      String                  @db.Text
  statusVistoria      String                  @db.VarChar(45)
  projetoObraId       Int
  usuarioId           Int
  etapaCronogramaId   Int
  etapaCronograma     etapa_cronograma        @relation(fields: [etapaCronogramaId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  projetoObra         projeto_obra            @relation(fields: [projetoObraId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  usuario             usuario                 @relation(fields: [usuarioId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  alertas             alerta_fiscalizacao[]
  evidencias          evidencia_fiscalizacao[]

  @@index([etapaCronogramaId], map: "fiscalizacao_etapaCronogramaId_fkey")
  @@index([projetoObraId], map: "fiscalizacao_projetoObraId_fkey")
  @@index([usuarioId], map: "fiscalizacao_usuarioId_fkey")
}

model evidencia_fiscalizacao {
  id              Int          @id @default(autoincrement())
  tipoEvidencia   String       @db.VarChar(45)
  caminhoArquivo  String       @db.VarChar(255)
  latitude        String       @db.VarChar(45)
  longitude       String       @db.VarChar(45)
  dataRegistro    DateTime     @default(now()) @db.DateTime(0)
  fiscalizacaoId  Int
  fiscalizacao    fiscalizacao @relation(fields: [fiscalizacaoId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([fiscalizacaoId], map: "evidencia_fiscalizacao_fiscalizacaoId_fkey")
}

model conta_bancaria {
  id             Int           @id @default(autoincrement())
  banco          String        @db.VarChar(100)
  agencia        String        @db.VarChar(20)
  numeroConta    String        @db.VarChar(30)
  tipoConta      String        @db.VarChar(45)
  orgaoPublicoId Int
  projetoObraId  Int
  orgaoPublico   orgao_publico @relation(fields: [orgaoPublicoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  projetoObra    projeto_obra  @relation(fields: [projetoObraId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([orgaoPublicoId], map: "conta_bancaria_orgaoPublicoId_fkey")
  @@index([projetoObraId], map: "conta_bancaria_projetoObraId_fkey")
}

model alerta_fiscalizacao {
  id              Int              @id @default(autoincrement())
  tipoAlerta      String           @db.VarChar(50)
  descricao       String           @db.Text
  severidade      String           @db.VarChar(20)
  dataGeracao     DateTime         @default(now()) @db.DateTime(0)
  statusAlerta    String           @db.VarChar(30)
  projetoObraId   Int
  fiscalizacaoId  Int
  fiscalizacao    fiscalizacao     @relation(fields: [fiscalizacaoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  projetoObra     projeto_obra     @relation(fields: [projetoObraId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  bloqueios       bloqueio_repasse[]

  @@index([fiscalizacaoId], map: "alerta_fiscalizacao_fiscalizacaoId_fkey")
  @@index([projetoObraId], map: "alerta_fiscalizacao_projetoObraId_fkey")
}

model bloqueio_repasse {
  id                    Int                     @id @default(autoincrement())
  motivoBloqueio        String                  @db.Text
  dataBloqueio          DateTime                @default(now()) @db.DateTime(0)
  statusBloqueio        String                  @db.VarChar(30)
  dataDesbloqueio       DateTime?               @db.DateTime(0)
  projetoObraId         Int
  alertaFiscalizacaoId  Int
  alertaFiscalizacao    alerta_fiscalizacao     @relation(fields: [alertaFiscalizacaoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  projetoObra           projeto_obra            @relation(fields: [projetoObraId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  processosReg          processo_regularizacao[]

  @@index([alertaFiscalizacaoId], map: "bloqueio_repasse_alertaFiscalizacaoId_fkey")
  @@index([projetoObraId], map: "bloqueio_repasse_projetoObraId_fkey")
}

model processo_regularizacao {
  id                    Int               @id @default(autoincrement())
  descricaoJustificativa String           @db.Text
  dataEnvio             DateTime          @default(now()) @db.DateTime(0)
  statusProcesso        String            @db.VarChar(30)
  bloqueioRepasseId     Int
  usuarioId             Int
  bloqueioRepasse       bloqueio_repasse  @relation(fields: [bloqueioRepasseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  usuario               usuario           @relation(fields: [usuarioId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([bloqueioRepasseId], map: "processo_regularizacao_bloqueioRepasseId_fkey")
  @@index([usuarioId], map: "processo_regularizacao_usuarioId_fkey")
}

model log_auditoria {
  id            Int      @id @default(autoincrement())
  acao          String   @db.VarChar(100)
  tabelaAfetada String   @db.VarChar(60)
  registroId    Int
  detalhes      String   @db.Text
  ipOrigem      String   @db.VarChar(45)
  dataHora      DateTime @default(now()) @db.DateTime(0)
  usuarioId     Int
  usuario       usuario  @relation(fields: [usuarioId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([usuarioId], map: "log_auditoria_usuarioId_fkey")
}